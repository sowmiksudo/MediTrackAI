# Mode: "cloud" (Mac / API-only) or "hybrid_gpu" (RTX 5050 local GPU + Cloud assist)
INFERENCE_MODE=cloud

# PostgreSQL + pgvector (docker-compose runs on port 5433 to avoid 5432 collisions)
DATABASE_URL=postgresql://meditrack:meditrack@localhost:5433/meditrack
PG_PORT=5433

# Security & Auth
JWT_SECRET=change-me-to-a-long-random-secret
FILE_SIGNING_SECRET=change-me-to-another-long-random-secret
JWT_EXPIRE_MINUTES=1440
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://localhost:5173,http://127.0.0.1:8080,https://dev-server.tenstral.com

# Server
HOST=0.0.0.0
PORT=8000
UPLOAD_DIR=uploads

# Cloud AI (Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_VLM_MODEL=gemini-3.8-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-2
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
COHERE_API_KEY=

# Hybrid Local GPU Settings (INFERENCE_MODE=hybrid_gpu)
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_MEDGEMMA_MODEL=medgemma-4b-q4
LOCAL_WHISPER_MODEL=large-v3-turbo
LOCAL_EMBED_MODEL=BAAI/bge-m3
LOCAL_RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
